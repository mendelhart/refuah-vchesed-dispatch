# -----------------------------------------------------------------------------
# The SPA, and the single origin it talks to.
#
# The browser must see one origin. The session cookie is SameSite=Lax — the
# right setting, because it is what stops a third-party page from making
# authenticated dispatch calls — and a Lax cookie is not sent on a cross-site
# request at all. So an SPA on one host calling an API on another host is not
# "a CORS problem to configure around"; it is a sign-in that silently never
# holds. Everything under /api and /webhooks is therefore proxied from here to
# API_ORIGIN, and the browser only ever addresses this host.
#
# nginx:alpine runs envsubst over this file at container start. Only variables
# that are actually set in the environment are substituted, which is why $uri,
# $proxy_host and friends survive untouched — and why PORT and API_ORIGIN, which
# the image does set, are the two that get replaced.
# -----------------------------------------------------------------------------
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  include /etc/nginx/snippets/security-headers.conf;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Hashed filenames: safe to cache forever.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
  }

  # Not hashed, and the one file that decides whether a client can update.
  location = /service-worker.js {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-headers.conf;
  }

  location /api/ {
    proxy_pass ${API_ORIGIN};
    include /etc/nginx/snippets/rvc-proxy.conf;
  }

  location /webhooks/ {
    proxy_pass ${API_ORIGIN};
    include /etc/nginx/snippets/rvc-proxy.conf;
  }

  # Everything else is the client router's problem, not a 404.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
