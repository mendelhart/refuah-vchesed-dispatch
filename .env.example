# =============================================================================
# Refuah V'Chesed Dispatch — configuration
#
# Copy to .env for local development. `npm run dev`, `db:migrate` and `db:seed`
# read it through Node's --env-file-if-exists; shell exports win; a missing
# file is not an error. Docker/Fly take configuration from the environment as
# usual — .env is a development convenience, never a deployment mechanism.
#
# The authoritative list of what configures this service, with validation
# rules, is apps/api/src/env.ts. If this file and env.ts disagree, env.ts wins.
# =============================================================================

# -----------------------------------------------------------------------------
# Required everywhere
# -----------------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string.
DATABASE_URL=postgres://rvc:rvc_local_dev_only@localhost:5432/rvc_dev

# [REQUIRED] At least 32 characters. Generate: openssl rand -base64 48
SESSION_SECRET=

# -----------------------------------------------------------------------------
# HTTP
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: 8080 / 0.0.0.0)
PORT=8080
HOST=0.0.0.0

# [OPTIONAL] Public origin of the web app; used for cookies, CORS and deep
# links (default: http://localhost:5173). In production: https://<web host>.
APP_URL=http://localhost:5173

# [OPTIONAL] Public origin of this API; used to build Twilio webhook URLs
# (default: http://localhost:8080). In production: https://<api host>.
API_PUBLIC_URL=http://localhost:8080

# [OPTIONAL] (default: rvc_session)
SESSION_COOKIE_NAME=rvc_session

# [REQUIRED in production] Serve the session cookie over HTTPS only. env.ts
# refuses to boot a production node with this false. Default: false (dev).
COOKIE_SECURE=false

# [OPTIONAL] (default: info) fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# [OPTIONAL] (default: 10) See env.ts before raising; scripts/e2e.sh overrides
# for the browser suite.
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# SMS / voice — Twilio. Absent in development selects the in-memory provider:
# sends are recorded, never transmitted. In production these are what make
# SMS, masked calling and the inbound webhook real.
# -----------------------------------------------------------------------------

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# [LOCAL TESTS ONLY] Skips webhook signature validation. env.ts refuses to
# boot with this true in production.
TWILIO_SKIP_SIGNATURE_VALIDATION=false

# -----------------------------------------------------------------------------
# Push — Web Push (VAPID). Generate: npx web-push generate-vapid-keys
# Absent in production: push is disabled and the API warns at boot.
# -----------------------------------------------------------------------------

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@refuahvchesed.org

# -----------------------------------------------------------------------------
# Geocoding — Nominatim, proxied server-side; the browser never sees it.
# -----------------------------------------------------------------------------

GEOCODER_USER_AGENT=RefuahVChesedDispatch/1.0
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_BIAS=Montreal, QC, Canada

# -----------------------------------------------------------------------------
# Email (transactional). 'none' = in-memory provider (default outside
# production): mail is recorded as a delivery row and logged, never sent.
# EMAIL_PROVIDER=smtp requires SMTP_HOST.
# -----------------------------------------------------------------------------

EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=Refuah V'Chesed <dispatch@refuahvchesed.org>
EMAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# WhatsApp — the organisation's existing WAHA server. Never the sole carrier
# for anything; absent config selects the in-memory provider.
# -----------------------------------------------------------------------------

# Uncomment and fill when WhatsApp goes live. An empty value fails URL validation.
# WAHA_BASE_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=     # HMAC key set on the WAHA session webhook (URL: <api>/webhooks/waha); required in production

# -----------------------------------------------------------------------------
# File storage — licence photographs are the most sensitive objects here.
# 'local' (default) writes under FILE_STORAGE_PATH; 's3' needs the S3_* block.
# -----------------------------------------------------------------------------

FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./var/files
# Uncomment and fill when document storage moves off the in-memory dev store. An empty value fails URL validation.
# S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# [REQUIRED in production] AES-256-GCM field-encryption key for licence
# numbers and images at rest — exactly 32 bytes, base64. Generate:
# openssl rand -base64 32. Absent elsewhere: those features refuse to store
# anything rather than storing it in clear.
FIELD_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Driver licence verification. There is no built-in provider: with 'none'
# (default) a licence can only reach 'on_file', never 'verified'.
# LICENCE_VERIFICATION_PROVIDER=http requires LICENCE_VERIFICATION_URL.
# -----------------------------------------------------------------------------

LICENCE_VERIFICATION_PROVIDER=none
# Uncomment with the verification endpoint when LICENCE_VERIFICATION_PROVIDER=http. An empty value fails URL validation.
# LICENCE_VERIFICATION_URL=
LICENCE_VERIFICATION_API_KEY=

# -----------------------------------------------------------------------------
# First administrator
#
# This system ships no default credentials. On a host where you can run a
# command (`npm run db:seed` locally, `fly ssh console` in production) the first
# account is created there. On a host with no shell, these two exist instead.
#
# With BOOTSTRAP_ADMIN_EMAIL set, the API creates ONE administrator at boot,
# with no password, and writes a single-use invitation link to the log. It is
# ignored once that account has a password, and ignored outright on a database
# that already has users — so it cannot be used to add an account to a running
# system. See apps/api/src/db/bootstrap-admin.ts.
#
# The link is built from APP_URL, so set that correctly or read the `path` field
# logged beside it.
# -----------------------------------------------------------------------------

# [OPTIONAL] Leave unset unless the host has no shell.
# BOOTSTRAP_ADMIN_EMAIL=

# [OPTIONAL] (default: Administrator) — the name on that account.
BOOTSTRAP_ADMIN_NAME=Administrator

# -----------------------------------------------------------------------------
# Public volunteer signup
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: true) Public /signup page and its endpoint.
PUBLIC_SIGNUP_ENABLED=true

# [OPTIONAL] (default: 5) Signup attempts per IP per hour.
SIGNUP_MAX_PER_IP_PER_HOUR=5

# -----------------------------------------------------------------------------
# Sign-in throttling
#
# The default is the real control against credential stuffing and should not
# be raised in production. It is configurable because the browser suite signs
# in as three roles from one IP; scripts/e2e.sh raises it there.
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: 10) Sign-in attempts per IP per five minutes.
LOGIN_MAX_PER_IP_PER_5MIN=10

# -----------------------------------------------------------------------------
# Error monitoring
# -----------------------------------------------------------------------------

# [OPTIONAL] Sentry DSN for the API. Unset = no reporting.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Background worker
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: true) Run the job worker inside the API process — fine
# up to a few thousand jobs/day. Set false to run `node dist/jobs/worker.js`
# as a separate process.
RUN_WORKER_IN_PROCESS=true

# [OPTIONAL] Read by scripts/docker-entrypoint.sh. Set false where the
# platform runs migrations as a release step (Fly's release_command does), so
# they do not also run on every machine as it boots.
RUN_MIGRATIONS_ON_START=true

# [OPTIONAL] Worker tuning (defaults: 2000 ms, 4).
WORKER_POLL_MS=2000
WORKER_CONCURRENCY=4
