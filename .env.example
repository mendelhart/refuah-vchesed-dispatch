# =============================================================================
# Refuah V'Chesed Dispatch — environment
#
# Copy to .env and edit:  cp .env.example .env
#
# This file mirrors apps/api/src/env.ts, variable for variable and in the same
# order. env.ts validates every one with zod at boot: a bad value stops the
# process at startup with a list of what is wrong, rather than failing later
# inside a request. If you add a variable there, add it here.
#
# Markers:
#   [REQUIRED]      no default — the process will not start without it
#   [REQUIRED-PROD] must be set (or must have this value) when NODE_ENV=production
#   [OPTIONAL]      has a working default; the comment shows it
#
# Two things to know before you edit a copy of this:
#
#   1. The development scripts — `npm run dev`, `db:migrate`, `db:seed` — read
#      .env through Node's own --env-file-if-exists, so there is no dotenv
#      dependency and a missing file is not an error. Variables already exported
#      in your shell take precedence. Everything that runs the compiled build
#      (`npm start`, Docker, Fly) reads the environment as usual and ignores this
#      file; docker-compose.yml sets its own values inline.
#   2. A variable that env.ts types as a URL cannot be present-but-empty —
#      zod rejects "" where it expects a URL. Those are left commented out
#      below rather than set to nothing. Setting an unused string variable to
#      an empty value is fine.
#
# NEVER commit a real secret. .gitignore excludes .env and .env.*; this file is
# the only exception and contains nothing but placeholders.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# [OPTIONAL] development | test | production   (default: development)
# 'production' additionally enforces COOKIE_SECURE=true,
# TWILIO_SKIP_SIGNATURE_VALIDATION=false and a present FIELD_ENCRYPTION_KEY, and
# warns when VAPID keys are absent. 'test' and 'development' select the
# in-memory SMS, push, calling, email, WhatsApp and object-store providers: they
# record each send and return a fake provider id instead of performing it, so a
# dev machine can never text or email a real volunteer.
NODE_ENV=development

# [OPTIONAL] 1-65535 (default: 8080)
PORT=8080

# [OPTIONAL] (default: 0.0.0.0) — 0.0.0.0 is required inside a container.
HOST=0.0.0.0

# [OPTIONAL] fatal|error|warn|info|debug|trace (default: info)
# 'debug' is useful locally; in production 'info' keeps the log volume sane.
# Logs redact cookies, tokens, phone numbers and passenger notes (lib/logger.ts).
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# [REQUIRED] Postgres 16 connection string. Without it the process refuses to
# start. Migration 0004 creates the btree_gist extension, so the role must be
# permitted to do that.
# Local (docker compose):  postgres://rvc:rvc_local_dev_only@localhost:5432/rvc_dev
# Fly:                     set by `fly postgres attach`; always ?sslmode=require
DATABASE_URL=postgres://rvc:rvc_local_dev_only@localhost:5432/rvc_dev

# [OPTIONAL] 1-100 (default: 10) — per process, not per cluster.
# machines x DATABASE_POOL_MAX must stay well under the server's max_connections,
# and each concurrently running job needs a connection.
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Public origins
#
# Both must be exact origins (scheme + host + optional port), no trailing slash.
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: http://localhost:5173)
# The CORS allow-list in production, and the base for offer deep links
# (`${APP_URL}/o/<code>`), invite and reset links, and the URLs inside message
# templates. A wrong value produces links that go nowhere.
APP_URL=http://localhost:5173

# [OPTIONAL] (default: http://localhost:8080)
# What Twilio webhook URLs are built from AND what their signatures are
# validated against. If it does not match the URL Twilio actually called, every
# webhook is rejected with 403 — which is the right failure, and the commonest
# deployment mistake. Local Twilio testing: use your tunnel, e.g.
# https://your-name.ngrok.app
API_PUBLIC_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Sessions and cookies
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: rvc_session)
SESSION_COOKIE_NAME=rvc_session

# [REQUIRED] At least 32 characters. Generate with:
#   openssl rand -base64 48
# Signs the session cookie. Rotating it invalidates every signed cookie, i.e.
# logs everyone out — which is the intended blast radius on a suspected
# compromise.
SESSION_SECRET=change-me-local-development-secret-at-least-32-characters

# [REQUIRED-PROD: must be true] (default: false)
# Marks the session cookie Secure. false on plain-HTTP localhost; the config
# loader throws at boot if this is false while NODE_ENV=production.
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Twilio — SMS and masked voice calls
#
# All three must be present for the Twilio provider to report enabled. Without
# them, development/test fall back to the in-memory provider (messages are
# recorded, not sent); production keeps the Twilio provider selected but disabled,
# so every SMS delivery fails and is visible in notification_deliveries.
# -----------------------------------------------------------------------------

# [OPTIONAL locally / REQUIRED-PROD for SMS]
TWILIO_ACCOUNT_SID=
# [OPTIONAL locally / REQUIRED-PROD for SMS] Also the key that validates every
# inbound webhook signature. Treat as a top-tier secret.
TWILIO_AUTH_TOKEN=
# [OPTIONAL locally / REQUIRED-PROD for SMS] E.164, e.g. +15145550000
TWILIO_PHONE_NUMBER=

# [REQUIRED-PROD: must be false] (default: false)
# Local escape hatch so webhook routes can be exercised with curl. The config
# loader refuses to start if this is true while NODE_ENV=production, and there
# is no runtime path that can turn it on.
TWILIO_SKIP_SIGNATURE_VALIDATION=true

# -----------------------------------------------------------------------------
# Web push (VAPID)
#
# Generate a pair once and keep it: replacing it invalidates every browser
# subscription already stored in push_subscriptions.
#   npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------

# [OPTIONAL] Absent => push disabled; deliveries are recorded 'skipped'. In
# production their absence is warned about at boot but is not fatal.
VAPID_PUBLIC_KEY=
# [OPTIONAL] Secret. Never expose; the browser only ever sees the public half,
# fetched from GET /api/push/public-key.
VAPID_PRIVATE_KEY=
# [OPTIONAL] (default: mailto:admin@refuahvchesed.org) — mailto: or https: URL
# that push services use to contact you about your traffic.
VAPID_SUBJECT=mailto:admin@refuahvchesed.org

# -----------------------------------------------------------------------------
# Geocoding (Nominatim, proxied server-side so browsers never call it directly)
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: RefuahVChesedDispatch/1.0)
# Nominatim's usage policy requires a real identifier with a contact address.
GEOCODER_USER_AGENT=RefuahVChesedDispatch/1.0 (ops@refuahvchesed.org)

# [OPTIONAL] (default: https://nominatim.openstreetmap.org)
# Point at a self-hosted instance to lift the public rate limit.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org

# [OPTIONAL] (default: Montreal, QC, Canada) — appended to every query.
GEOCODER_BIAS=Montreal, QC, Canada

# -----------------------------------------------------------------------------
# Email (transactional)
#
# Carries applicant acknowledgements, approval messages with their invite link,
# rejection messages, reviewer alerts and export-ready mail. SMTP rather than a
# vendor SDK so the organisation can move between Google Workspace, Postmark,
# SES or a shared host by changing four variables.
#
# NOTE: invite and password-reset links issued by issueAuthToken() are NOT
# emailed — they are logged and returned to the administrator, who passes them
# on. Only applicant messages go out through this provider.
# -----------------------------------------------------------------------------

# [OPTIONAL] none | smtp (default: none)
# 'none' selects the in-memory provider: the delivery row is written and marked
# sent, but nothing leaves the machine.
EMAIL_PROVIDER=none

# [REQUIRED-PROD when EMAIL_PROVIDER=smtp] The mail host. env.ts throws at boot
# if EMAIL_PROVIDER=smtp with no host while NODE_ENV=production; elsewhere the
# provider simply reports itself disabled and the in-memory one is used.
SMTP_HOST=

# [OPTIONAL] 1-65535 (default: 587)
SMTP_PORT=587

# [OPTIONAL] Omit both for a host that does not authenticate.
SMTP_USER=
# [OPTIONAL] Secret.
SMTP_PASSWORD=

# [OPTIONAL] (default: false) — true for implicit TLS, normally on port 465.
SMTP_SECURE=false

# [OPTIONAL] (default: Refuah V'Chesed <dispatch@refuahvchesed.org>)
# The From header on every outbound message.
EMAIL_FROM=Refuah V'Chesed <dispatch@refuahvchesed.org>

# [OPTIONAL] Default Reply-To. Absent, replies go to EMAIL_FROM.
EMAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# WhatsApp (WAHA)
#
# The organisation already runs a WAHA server paired with its own number; this
# speaks its HTTP API rather than replacing it. WhatsApp is a *preference*,
# never the sole carrier: a paired session can drop silently, so the whatsapp
# preference is always paired with push and offers force SMS and push.
# -----------------------------------------------------------------------------

# [OPTIONAL] Base URL of the WAHA server. Absent => the in-memory provider, and
# every WhatsApp delivery is recorded rather than sent. Must be a valid URL if
# present at all, so leave it commented out rather than empty.
# WAHA_BASE_URL=https://waha.internal.example

# [OPTIONAL] Sent as X-Api-Key when set. Secret.
WAHA_API_KEY=

# [OPTIONAL] (default: default) — the WAHA session name to send from.
WAHA_SESSION=default

# -----------------------------------------------------------------------------
# File storage
#
# Holds driver licence photographs and generated exports. Restricted files are
# encrypted with FIELD_ENCRYPTION_KEY before they are written, so the bytes on
# disk or in a bucket are useless without it.
# -----------------------------------------------------------------------------

# [OPTIONAL] local | s3 (default: local)
# In tests an in-memory store is always used regardless of this value.
FILE_STORAGE_DRIVER=local

# [OPTIONAL] (default: ./var/files) — where the local driver writes. On a
# container with an ephemeral disk this is lost on every deploy: mount a volume,
# or use the s3 driver.
FILE_STORAGE_PATH=./var/files

# [OPTIONAL] Required in practice when FILE_STORAGE_DRIVER=s3. Any S3-compatible
# endpoint; spoken to directly over REST with SigV4, no AWS SDK. Must be a valid
# URL if present at all, so leave it commented out rather than empty.
# S3_ENDPOINT=https://s3.ca-central-1.example

# [OPTIONAL] (default: us-east-1) — must match the bucket, or signing fails.
# Use a Canadian region: this data must stay in Canada.
S3_REGION=us-east-1

# [OPTIONAL] Required when FILE_STORAGE_DRIVER=s3.
S3_BUCKET=

# [OPTIONAL] Secret. Required when FILE_STORAGE_DRIVER=s3.
S3_ACCESS_KEY_ID=
# [OPTIONAL] Secret. Required when FILE_STORAGE_DRIVER=s3.
S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Field encryption
# -----------------------------------------------------------------------------

# [REQUIRED-PROD] 32 bytes, base64, for AES-256-GCM encryption of driver licence
# numbers and of restricted files at rest. Generate with:
#   openssl rand -base64 32
# Any value that does not decode to exactly 32 bytes is rejected at boot in
# every environment. Absent outside production, those features REFUSE to store
# anything rather than storing it in clear.
#
# There is no key rotation: nothing re-encrypts existing values, and losing this
# key makes every stored licence number and encrypted file permanently
# unreadable. Keep it where the organisation keeps its other irreplaceable
# secrets.
FIELD_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Driver licence verification
#
# There is no built-in verification and no default provider. This system does
# NOT verify licences; it stores an image for a person to look at. With no
# provider configured a licence can only ever reach status 'on_file' — never
# 'verified' — and the database enforces the same rule independently.
# -----------------------------------------------------------------------------

# [OPTIONAL] none | http (default: none)
# 'none' is not a degraded mode: it reports 'unsupported', always, and is the
# honest answer when no verification service exists.
LICENCE_VERIFICATION_PROVIDER=none

# [REQUIRED-PROD when LICENCE_VERIFICATION_PROVIDER=http] The contracted
# service's endpoint. env.ts throws at boot if the provider is 'http' with no
# URL while NODE_ENV=production; elsewhere the client reports itself disabled.
# Must be a valid URL if present at all, so leave it commented out rather than
# empty.
# LICENCE_VERIFICATION_URL=https://verify.example/api/licence

# [OPTIONAL] Secret. Sent as a bearer token when set.
LICENCE_VERIFICATION_API_KEY=

# -----------------------------------------------------------------------------
# Public signup
#
# POST /api/public/volunteer-applications is the only unauthenticated write
# endpoint in the API.
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: true)
# false closes the public application form and its options endpoint with a 403.
PUBLIC_SIGNUP_ENABLED=true

# [OPTIONAL] 1-100 (default: 5) — per-IP hourly limit on that endpoint, far
# tighter than the global 300/minute. Read per request rather than captured at
# boot, so it can be tuned without a restart. Raise it only deliberately.
SIGNUP_MAX_PER_IP_PER_HOUR=5

# [OPTIONAL] 1-1000 (default: 10) — sign-in attempts per IP per five minutes.
# This is the control against credential stuffing; leave it alone in production.
# It exists as a variable only so the browser suite, which signs in as three
# roles from one address, does not throttle itself. scripts/e2e.sh raises it.
LOGIN_MAX_PER_IP_PER_5MIN=10

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------

# [OPTIONAL] When set, initMonitoring() imports @sentry/node at runtime — but
# that package is NOT a dependency of @rvc/api. With a DSN set and the package
# missing, the API logs an error at boot and errors go to the logs only. Either
# `npm i @sentry/node -w @rvc/api` or leave this unset.
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Background worker
#
# The worker drives offer expiry, reminders, escalation, notification delivery
# and retries, standing-ride materialisation, equipment and licence scans, duty
# reminders, exports, broadcasts, and session/token/retention cleanup. If
# nothing is running it, none of that happens and no message is ever sent.
# -----------------------------------------------------------------------------

# [OPTIONAL] (default: true)
# true  — the worker runs inside the API process (correct at this volume).
# false — you MUST run `node dist/jobs/worker.js` as a separate process.
RUN_WORKER_IN_PROCESS=true

# [OPTIONAL] 200-60000 ms (default: 2000) — queue poll interval. Lower means
# snappier offers and more idle queries against `jobs`.
WORKER_POLL_MS=2000

# [OPTIONAL] 1-50 (default: 4) — jobs claimed per tick. Keep below
# DATABASE_POOL_MAX; each running job needs a connection. This is the first
# thing to raise if the tail of a broadcast arrives too late.
WORKER_CONCURRENCY=4

# [OPTIONAL] (default: true) — read by scripts/docker-entrypoint.sh.
# Set false where the platform applies migrations as a release step rather than
# on boot. Fly does exactly that (`release_command` in fly.toml), so a Fly
# deployment should set this to false; otherwise every machine re-runs the
# migrator as it starts, which is harmless but noisy and serialises the rollout.
RUN_MIGRATIONS_ON_START=true

# =============================================================================
# Web app (apps/web) — read by Vite, NOT part of apps/api/src/env.ts
# =============================================================================

# [OPTIONAL] (default: http://127.0.0.1:8080) — the target the dev server and
# `vite preview` proxy /api and /webhooks to. In a built SPA served by nginx
# there is no proxy: the browser calls API_PUBLIC_URL directly and CORS is
# allow-listed to APP_URL by the API.
VITE_API_URL=http://127.0.0.1:8080
