{
  "name": "@rvc/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "node dist/jobs/worker.js",
    "files:check": "tsx --env-file-if-exists=../../.env src/db/check-files.ts",
    "keys:rotate": "tsx --env-file-if-exists=../../.env src/db/rotate-keys.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@hebcal/core": "^5.10.1",
    "@rvc/shared": "*",
    "@sentry/node": "^11.0.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.2.1",
    "nodemailer": "^10.0.10",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "twilio": "^5.4.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.6"
  }
}
